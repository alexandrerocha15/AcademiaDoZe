<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="AcademiaDoZe.Presentation.AppMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Views"    xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers"
    Title="Academia do Zé">

    <FlyoutItem Title="{helpers:Translate strDashboard}">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialIcons"
                Glyph="&#xe871;" />
        </FlyoutItem.Icon>

        <ShellContent
            ContentTemplate="{DataTemplate views:DashboardListPage}"
            Route="dashboard" />
    </FlyoutItem>

    <FlyoutItem Title="{helpers:Translate strLogradouro}">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialIcons"
                Glyph="&#xe7f1;" />
        </FlyoutItem.Icon>

        <ShellContent
            ContentTemplate="{DataTemplate views:LogradouroListPage}"
            Route="logradouros" />
    </FlyoutItem>

    <FlyoutItem Title="{helpers:Translate strConfiguracao}">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialIcons"
                Glyph="&#xe8b8;" />
        </FlyoutItem.Icon>

        <ShellContent
            ContentTemplate="{DataTemplate views:ConfigPage}"
            Route="configuracoes" />
    </FlyoutItem>
        
    <FlyoutItem Title="{helpers:Translate strColaborador}">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xea67;" />
        </FlyoutItem.Icon>
        <ShellContent
            ContentTemplate="{DataTemplate views:ColaboradorListPage}"
            Route="colaboradores" />
    </FlyoutItem>

    <FlyoutItem Title="{helpers:Translate strAluno}">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe7ef;" />
        </FlyoutItem.Icon>
        <ShellContent
            ContentTemplate="{DataTemplate views:AlunoListPage}"
            Route="alunos" />
    </FlyoutItem>
        
    <FlyoutItem Title="{helpers:Translate strMatricula}">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialIcons"
                Glyph="&#xefec;" />
        </FlyoutItem.Icon>

        <ShellContent
            ContentTemplate="{DataTemplate views:MatriculaListPage}"
            Route="matriculas" />
    </FlyoutItem>

    <FlyoutItem Title="{helpers:Translate strAcessoAlunoTitulo}">
        <ShellContent ContentTemplate="{DataTemplate views:AcessoAlunoPage}" Route="acesso-alunos" />
    </FlyoutItem>

    <FlyoutItem Title="{helpers:Translate strAcessoColaboradorTitulo}">
        <ShellContent ContentTemplate="{DataTemplate views:AcessoColaboradorPage}" Route="acesso-colaboradores" />
    </FlyoutItem>

</Shell>