<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
    xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.AlunoListPage"
    x:DataType="vm:AlunoListViewModel"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="10" RowSpacing="10">

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="10">
            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                <Picker
                    ItemsSource="{Binding FilterTypes}"
                    SelectedItem="{Binding SelectedFilterType}"
                    SelectedIndexChanged="OnFilterChanged" />

                <Entry
                    Grid.Column="1"
                    Text="{Binding SearchText}"
                    Placeholder="Buscar aluno..."
                    ReturnCommand="{Binding SearchAlunosCommand}"
                    TextChanged="OnSearchTextChanged" />

                <Button
                    Grid.Column="2"
                    Text="Buscar"
                    Command="{Binding SearchAlunosCommand}"
                    Style="{StaticResource ButtonPrimary}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">

            <RefreshView
                IsRefreshing="{Binding IsRefreshing}"
                Command="{Binding RefreshCommand}">

                <CollectionView
                    ItemsSource="{Binding Alunos}"
                    SelectionMode="None">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical">
                            <GridItemsLayout.Span>
                                <OnIdiom
                                    x:TypeArguments="x:Int32"
                                    Phone="1"
                                    Tablet="2"
                                    Desktop="3"
                                    TV="4"
                                    Default="1" />
                            </GridItemsLayout.Span>
                        </GridItemsLayout>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:AlunoDto">
                            <Border
                                Style="{StaticResource CardBorder}"
                                Margin="8"
                                Padding="12">

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">

                                    <VerticalStackLayout Spacing="6">
                                        <Label
                                            Text="{Binding Nome}"
                                            FontAttributes="Bold"
                                            FontSize="17" />

                                        <Label
                                            Text="{Binding Cpf, StringFormat='CPF: {0}'}" />

                                        <Label
                                            Text="{Binding Telefone, StringFormat='Telefone: {0}'}" />

                                        <Label
                                            Text="{Binding Email, StringFormat='E-mail: {0}'}" />

                                        <Label
                                            Text="{Binding DataNascimento, StringFormat='Nascimento: {0:dd/MM/yyyy}'}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="8">

                                        <Image
                                            Source="{Binding Foto, Converter={StaticResource FotoConverter}}"
                                            WidthRequest="100"
                                            HeightRequest="100"
                                            Aspect="AspectFill" />

                                        <Button
                                            Text="Editar"
                                            Clicked="OnEditButtonClicked"
                                            Style="{StaticResource ButtonSmall}" />

                                        <Button
                                            Text="Excluir"
                                            Clicked="OnDeleteButtonClicked"
                                            Style="{StaticResource ButtonDanger}" />

                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <Label
                            Text="Nenhum aluno encontrado."
                            Padding="20"
                            HorizontalTextAlignment="Center" />
                    </CollectionView.EmptyView>

                </CollectionView>
            </RefreshView>

            <Button
                Text="+"
                Command="{Binding AddAlunoCommand}"
                Style="{StaticResource ButtonPrimary}"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                FontSize="24"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20" />
        </Grid>

        <ActivityIndicator
            Grid.RowSpan="2"
            IsVisible="{Binding IsBusy}"
            IsRunning="{Binding IsBusy}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>