<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
    xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ColaboradorListPage"
    x:DataType="vm:ColaboradorListViewModel"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoConverter" />
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />

        <DataTemplate x:Key="ColaboradorTemplate" x:DataType="dto:ColaboradorDto">
            <Border Style="{StaticResource CardBorder}" Margin="8" Padding="12">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">

                    <Label Grid.Row="0" Text="{Binding Nome}" FontAttributes="Bold" FontSize="17" />
                    <Label Grid.Row="1" Text="{Binding Cpf, StringFormat='CPF: {0}'}" />
                    <Label Grid.Row="2" Text="{Binding Telefone, StringFormat='Telefone: {0}'}" />
                    <Label Grid.Row="3" Text="{Binding Email, StringFormat='E-mail: {0}'}" />
                    <Label Grid.Row="4" Text="{Binding DataNascimento, StringFormat='Nascimento: {0:dd/MM/yyyy}'}" />
                    <Label Grid.Row="5" Text="{Binding DataAdmissao, StringFormat='Admissão: {0:dd/MM/yyyy}'}" />
                    <Label Grid.Row="6" Text="{Binding Tipo, Converter={StaticResource EnumDisplay}, StringFormat='Cargo: {0}'}" />
                    <Label Grid.Row="7" Text="{Binding Vinculo, Converter={StaticResource EnumDisplay}, StringFormat='Vínculo: {0}'}" />

                    <VerticalStackLayout Grid.Column="1" Grid.RowSpan="8" Spacing="8">
                        <Image Source="{Binding Foto, Converter={StaticResource FotoConverter}}"
                               HeightRequest="100" WidthRequest="100" Aspect="AspectFill" />

                        <Button Text="Editar" Clicked="OnEditButtonClicked"
                                Style="{StaticResource ButtonSmall}" />

                        <Button Text="Excluir" Clicked="OnDeleteButtonClicked"
                                Style="{StaticResource ButtonDanger}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="10" RowSpacing="10">

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="10">
            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                <Picker Grid.Column="0"
                        ItemsSource="{Binding FilterTypes}"
                        SelectedItem="{Binding SelectedFilterType}" />

                <Entry Grid.Column="1"
                       Text="{Binding SearchText}"
                       Placeholder="Buscar..."
                       ReturnCommand="{Binding SearchColaboradoresCommand}" />

                <Button Grid.Column="2"
                        Text="Buscar"
                        Command="{Binding SearchColaboradoresCommand}"
                        Style="{StaticResource ButtonPrimary}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}">

                <CollectionView ItemsSource="{Binding Colaboradores}"
                                SelectionMode="None">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical">
                            <GridItemsLayout.Span>
                                <OnIdiom x:TypeArguments="x:Int32"
                                         Phone="1"
                                         Tablet="2"
                                         Desktop="3"
                                         TV="4"
                                         Default="1" />
                            </GridItemsLayout.Span>
                        </GridItemsLayout>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <StaticResource Key="ColaboradorTemplate" />
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20" Spacing="15">
                            <Label Text="Nenhum colaborador encontrado"
                                   HorizontalOptions="Center" />
                            <Button Text="Adicionar Colaborador"
                                    Command="{Binding AddColaboradorCommand}"
                                    Style="{StaticResource ButtonPrimary}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>

            <Button Text="+"
                    Command="{Binding AddColaboradorCommand}"
                    Style="{StaticResource ButtonPrimary}"
                    WidthRequest="56"
                    HeightRequest="56"
                    CornerRadius="28"
                    FontSize="24"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="20" />
        </Grid>

        <ActivityIndicator Grid.RowSpan="2"
                           IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
