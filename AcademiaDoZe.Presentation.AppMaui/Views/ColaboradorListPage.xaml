<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
    xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ColaboradorListPage"
    x:DataType="vm:ColaboradorListViewModel"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoConverter" />
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />

        <DataTemplate x:Key="ColaboradorTemplate" x:DataType="dto:ColaboradorDto">
            <Border Style="{StaticResource CardBorder}" Margin="8" Padding="12">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">

                    <Label Grid.Row="0" Text="{Binding Nome}" FontAttributes="Bold" FontSize="17" />
                    <Label Grid.Row="1" Text="{Binding Cpf, StringFormat='CPF: {0}'}" />
                    <Label Grid.Row="2"><Label.FormattedText><FormattedString><Span Text="{helpers:Translate strTelefone}"/><Span Text=": "/><Span Text="{Binding Telefone}"/></FormattedString></Label.FormattedText></Label>
                    <Label Grid.Row="3" Text="{Binding Email, StringFormat='E-mail: {0}'}" />
                    <Label Grid.Row="4"><Label.FormattedText><FormattedString><Span Text="{helpers:Translate strNascimento}"/><Span Text=": "/><Span Text="{Binding DataNascimento, StringFormat='{0:dd/MM/yyyy}'}"/></FormattedString></Label.FormattedText></Label>
                    <Label Grid.Row="5"><Label.FormattedText><FormattedString><Span Text="{helpers:Translate strDataAdmissao}"/><Span Text=": "/><Span Text="{Binding DataAdmissao, StringFormat='{0:dd/MM/yyyy}'}"/></FormattedString></Label.FormattedText></Label>
                    <Label Grid.Row="6"><Label.FormattedText><FormattedString><Span Text="{helpers:Translate strCargoLista}"/><Span Text=": "/><Span Text="{Binding Tipo, Converter={StaticResource EnumDisplay}}"/></FormattedString></Label.FormattedText></Label>
                    <Label Grid.Row="7"><Label.FormattedText><FormattedString><Span Text="{helpers:Translate strVinculo}"/><Span Text=": "/><Span Text="{Binding Vinculo, Converter={StaticResource EnumDisplay}}"/></FormattedString></Label.FormattedText></Label>

                    <VerticalStackLayout Grid.Column="1" Grid.RowSpan="8" Spacing="8">
                        <Image Source="{Binding Foto, Converter={StaticResource FotoConverter}}"
                               HeightRequest="100" WidthRequest="100" Aspect="AspectFill" />

                        <Button Text="{helpers:Translate strEditar}" Clicked="OnEditButtonClicked"
                                Style="{StaticResource ButtonSmall}" />

                        <Button Text="{helpers:Translate strExcluir}" Clicked="OnDeleteButtonClicked"
                                Style="{StaticResource ButtonDanger}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="10" RowSpacing="10">

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="10">
            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                <Picker Grid.Column="0"
                    ItemsSource="{Binding FilterTypes}"
                    SelectedItem="{Binding SelectedFilterType}"
                    SelectedIndexChanged="OnFilterChanged" />

                <Entry Grid.Column="1"
                    Text="{Binding SearchText}"
                    TextChanged="OnSearchTextChanged"
                    Placeholder="{helpers:Translate strBuscarGenerico}"
                    ReturnCommand="{Binding SearchColaboradoresCommand}" />

                <Button Grid.Column="2"
                        Text="{helpers:Translate strBuscar}"
                        Command="{Binding SearchColaboradoresCommand}"
                        Style="{StaticResource ButtonPrimary}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}">

                <CollectionView ItemsSource="{Binding Colaboradores}"
                                SelectionMode="None">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical">
                            <GridItemsLayout.Span>
                                <OnIdiom x:TypeArguments="x:Int32"
                                         Phone="1"
                                         Tablet="2"
                                         Desktop="3"
                                         TV="4"
                                         Default="1" />
                            </GridItemsLayout.Span>
                        </GridItemsLayout>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <StaticResource Key="ColaboradorTemplate" />
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20" Spacing="15">
                            <Label Text="{helpers:Translate strNenhumColaborador}"
                                   HorizontalOptions="Center" />
                            <Button Text="{helpers:Translate strAdicionarColaborador}"
                                    Command="{Binding AddColaboradorCommand}"
                                    Style="{StaticResource ButtonPrimary}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>

            <Button Text="+"
                    Command="{Binding AddColaboradorCommand}"
                    Style="{StaticResource ButtonPrimary}"
                    WidthRequest="56"
                    HeightRequest="56"
                    CornerRadius="28"
                    FontSize="24"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="20" />
        </Grid>

        <ActivityIndicator Grid.RowSpan="2"
                           IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
