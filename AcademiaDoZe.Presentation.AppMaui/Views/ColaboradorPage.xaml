<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ColaboradorPage"
    x:DataType="vm:ColaboradorViewModel"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoConverter" />
        <converters:DateOnlyToDateTimeConverter x:Key="DateOnlyConverter" />
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="15">

            <!-- CPF -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="CPF" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry Text="{Binding Colaborador.Cpf}"
                               Placeholder="000.000.000-00"
                               Keyboard="Numeric"
                               MaxLength="14"
                               ReturnCommand="{Binding SearchByCpfCommand}" />
                        <Button Grid.Column="1"
                                Text="{helpers:Translate strBuscarCpf}"
                                Command="{Binding SearchByCpfCommand}"
                                Style="{StaticResource ButtonPrimary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- DADOS PESSOAIS -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="{helpers:Translate strDadosPessoais}"
                           Style="{StaticResource SubHeadline}" />

                    <Label Text="{Binding Colaborador.Id, StringFormat='Colaborador ID: {0}'}"
                           IsVisible="{Binding IsEditMode}" />

                    <Label Text="{helpers:Translate strNome}" />
                    <Entry Text="{Binding Colaborador.Nome}"
                           Placeholder="{helpers:Translate strNomeCompleto}"
                           MaxLength="150" />

                    <Label Text="{helpers:Translate strNascimento}" />
                    <DatePicker Date="{Binding Colaborador.DataNascimento, Converter={StaticResource DateOnlyConverter}, Mode=TwoWay}"
                                Format="dd/MM/yyyy" />

                    <Label Text="{helpers:Translate strTelefone}" />
                    <Entry Text="{Binding Colaborador.Telefone}"
                           Keyboard="Telephone"
                           Placeholder="(00) 00000-0000"
                           MaxLength="15" />

                    <Label Text="E-mail" />
                    <Entry x:Name="EmailEntry"
                           Text="{Binding Colaborador.Email}"
                           Keyboard="Email"
                           Placeholder="exemplo@email.com"
                           Unfocused="OnEmailUnfocused" />

                    <Label x:Name="EmailErrorLabel"
                           Text="{helpers:Translate strEmailInvalido}"
                           TextColor="Red"
                           FontSize="12"
                           IsVisible="False" />

                    <Label Text="{helpers:Translate strSenha}" />
                    <Entry x:Name="SenhaEntry"
                           Text="{Binding Colaborador.Senha}"
                           IsPassword="True"
                           Placeholder="{helpers:Translate strDigiteSenha}" />

                    <HorizontalStackLayout Spacing="10">
                        <Switch Toggled="OnShowPasswordToggled" />
                        <Label Text="{helpers:Translate strMostrarSenha}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Text="{helpers:Translate strSenhaAtual}"
                           FontSize="12"
                           IsVisible="{Binding IsEditMode}" />

                    <Label Text="{helpers:Translate strConfirmarSenha}" />
                    <Entry Text="{Binding ConfirmarSenha}"
                           IsPassword="True"
                           Placeholder="{helpers:Translate strConfirmeSenha}" />

                    <Label Text="{helpers:Translate strFoto}" />
                    <Image Source="{Binding Colaborador.Foto, Converter={StaticResource FotoConverter}}"
                           WidthRequest="120"
                           HeightRequest="120"
                           Aspect="AspectFill"
                           HorizontalOptions="Start">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelecionarFotoCommand}"
                                NumberOfTapsRequired="1" />
                        </Image.GestureRecognizers>
                    </Image>

                    <Button Text="{helpers:Translate strSelecionarImagem}"
                            Command="{Binding SelecionarFotoCommand}"
                            Style="{StaticResource ButtonPrimary}" />

                </VerticalStackLayout>
            </Border>

            <!-- ENDEREÇO -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="{helpers:Translate strEndereco}"
                           Style="{StaticResource SubHeadline}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry Text="{Binding Colaborador.Endereco.Cep}"
                               Placeholder="00000-000"
                               Keyboard="Numeric"
                               MaxLength="9"
                               ReturnCommand="{Binding SearchByCepCommand}" />

                        <Button Grid.Column="1"
                                Text="{helpers:Translate strBuscarCep}"
                                Command="{Binding SearchByCepCommand}"
                                Style="{StaticResource ButtonPrimary}" />
                    </Grid>

                    <Label Text="{helpers:Translate strSemLogradouro}"
                           IsVisible="{Binding HasNoEnderecoVinculado}"
                           FontSize="12" />

                    <VerticalStackLayout Spacing="5"
                                         IsVisible="{Binding HasEnderecoVinculado}">
                        <Label Text="{helpers:Translate strLogradouroVinculado}"
                               FontAttributes="Bold" />
                        <Label Text="{Binding Colaborador.Endereco.Nome, StringFormat='Rua: {0}'}" />
                        <Label Text="{Binding Colaborador.Endereco.Bairro, StringFormat='Bairro: {0}'}" />
                        <Label Text="{Binding Colaborador.Endereco.Cidade, StringFormat='Cidade: {0}'}" />
                        <Label Text="{Binding Colaborador.Endereco.Estado, StringFormat='Estado: {0}'}" />
                    </VerticalStackLayout>

                    <Label Text="{helpers:Translate strNumero}" />
                    <Entry Text="{Binding Colaborador.Numero}"
                           Placeholder="{helpers:Translate strNumero}" />

                    <Label Text="{helpers:Translate strComplemento}" />
                    <Entry Text="{Binding Colaborador.Complemento}"
                           Placeholder="{helpers:Translate strComplementoOpcional}" />

                </VerticalStackLayout>
            </Border>

            <!-- DADOS DE TRABALHO -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="{helpers:Translate strDadosTrabalho}"
                           Style="{StaticResource SubHeadline}" />

                    <Label Text="{helpers:Translate strDataAdmissao}" />
                    <DatePicker Date="{Binding Colaborador.DataAdmissao, Converter={StaticResource DateOnlyConverter}, Mode=TwoWay}"
                                Format="dd/MM/yyyy" />

                    <Label Text="{helpers:Translate strTipo}" />
                    <Picker ItemsSource="{Binding ColaboradorTipos}"
                            SelectedItem="{Binding Colaborador.Tipo}">
                        <Picker.ItemDisplayBinding>
                            <Binding Converter="{StaticResource EnumDisplay}" />
                        </Picker.ItemDisplayBinding>
                    </Picker>

                    <Label Text="{helpers:Translate strVinculo}" />
                    <Picker ItemsSource="{Binding ColaboradorVinculos}"
                            SelectedItem="{Binding Colaborador.Vinculo}">
                        <Picker.ItemDisplayBinding>
                            <Binding Converter="{StaticResource EnumDisplay}" />
                        </Picker.ItemDisplayBinding>
                    </Picker>

                </VerticalStackLayout>
            </Border>

            <!-- AÇÕES -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Cancelar"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource ButtonSecondary}"
                        HeightRequest="50" />

                <Button Grid.Column="1"
                        Text="{helpers:Translate strSalvar}"
                        Command="{Binding SaveColaboradorCommand}"
                        Style="{StaticResource ButtonPrimary}"
                        HeightRequest="50" />
            </Grid>

            <ActivityIndicator IsVisible="{Binding IsBusy}"
                               IsRunning="{Binding IsBusy}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
