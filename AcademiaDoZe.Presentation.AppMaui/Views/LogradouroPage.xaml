<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.LogradouroPage"
             xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:LogradouroViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <StackLayout Spacing="20">

            <!-- CEP Section -->
            <Border Style="{StaticResource CardBorder}" Margin="15,10">
                <StackLayout Spacing="5">

                    <Label Text="CEP"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Grid.Column="0"
                               Text="{Binding Logradouro.Cep}"
                               Placeholder="00000-000"
                               Keyboard="Numeric"
                               Margin="0,0,10,0"/>

                        <Button Grid.Column="1"
                                Text="{helpers:Translate strBuscarCEP}"
                                Command="{Binding SearchByCepCommand}"
                                Style="{StaticResource ButtonPrimary}"
                                HeightRequest="40"
                                Padding="15,0">
                            <Button.ImageSource>
                                <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe8b6;"
                                    Size="20" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>

                </StackLayout>
            </Border>

            <!-- Dados do Logradouro -->
            <Border Style="{StaticResource CardBorder}" Margin="15,10">
                <StackLayout Spacing="15">

                    <Label Text="{Binding Logradouro.Id, StringFormat='Logradouro ID: {0}'}"
                           Style="{StaticResource SubHeadline}"/>

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strNomeRua}"/>
                        <Entry Text="{Binding Logradouro.Nome}"
                               Placeholder="{helpers:Translate strDigiteONomeDaRua}"/>
                    </StackLayout>

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strBairro}"/>
                        <Entry Text="{Binding Logradouro.Bairro}"
                               Placeholder="{helpers:Translate strDigiteOBairro}"/>
                    </StackLayout>

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strCidade}"/>
                        <Entry Text="{Binding Logradouro.Cidade}"
                               Placeholder="{helpers:Translate strDigiteACidade}"/>
                    </StackLayout>

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strEstado}"/>
                        <Entry Text="{Binding Logradouro.Estado}"
                               Placeholder="{helpers:Translate strDigiteOEstado}"/>
                    </StackLayout>

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strPais}"/>
                        <Entry Text="{Binding Logradouro.Pais}"
                               Placeholder="{helpers:Translate strDigiteOPais}"/>
                    </StackLayout>

                </StackLayout>
            </Border>

            <!-- Botões de Ação -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="10"
                  Margin="15,10">

                <Button Grid.Column="0"
                        Text="{helpers:Translate strCancelar004}"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource ButtonSecondary}"
                        HeightRequest="50">
                    <Button.ImageSource>
                        <FontImageSource
                            FontFamily="MaterialIcons"
                            Glyph="&#xe5c9;"
                            Size="20" />
                    </Button.ImageSource>
                </Button>

                <Button Grid.Column="1"
                        Text="{helpers:Translate strSalvar005}"
                        Command="{Binding SaveLogradouroCommand}"
                        Style="{StaticResource ButtonPrimary}"
                        HeightRequest="50">
                    <Button.ImageSource>
                        <FontImageSource
                            FontFamily="MaterialIcons"
                            Glyph="&#xe161;"
                            Size="20" />
                    </Button.ImageSource>
                </Button>
            </Grid>

            <ActivityIndicator IsVisible="{Binding IsBusy}"
                               IsRunning="{Binding IsBusy}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>

        </StackLayout>
    </ScrollView>

</ContentPage>