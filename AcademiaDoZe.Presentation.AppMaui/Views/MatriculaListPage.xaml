<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
    xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.MatriculaListPage"
    x:DataType="vm:MatriculaListViewModel"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoConverter" />
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />
        <converters:RestricoesFlagsDisplayConverter x:Key="RestricoesDisplay" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="10" RowSpacing="10">

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="10">
            <Grid ColumnDefinitions="130,*,Auto" ColumnSpacing="8">
                <Picker
                    ItemsSource="{Binding FilterTypes}"
                    SelectedItem="{Binding SelectedFilterType}" />

                <Entry
                    Grid.Column="1"
                    Text="{Binding SearchText}"
                    Placeholder="Buscar matrícula..."
                    ReturnCommand="{Binding SearchMatriculasCommand}" />

                <Button
                    Grid.Column="2"
                    Text="Buscar"
                    Command="{Binding SearchMatriculasCommand}"
                    Style="{StaticResource ButtonPrimary}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <RefreshView
                IsRefreshing="{Binding IsRefreshing}"
                Command="{Binding RefreshCommand}">

                <CollectionView
                    ItemsSource="{Binding Matriculas}"
                    SelectionMode="None">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical">
                            <GridItemsLayout.Span>
                                <OnIdiom
                                    x:TypeArguments="x:Int32"
                                    Phone="1"
                                    Tablet="2"
                                    Desktop="3"
                                    TV="4"
                                    Default="1" />
                            </GridItemsLayout.Span>
                        </GridItemsLayout>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:MatriculaDto">
                            <Border
                                Style="{StaticResource CardBorder}"
                                Margin="8"
                                Padding="12">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                                    <VerticalStackLayout Spacing="6">
                                        <Label
                                            Text="{Binding AlunoMatricula.Nome}"
                                            FontAttributes="Bold"
                                            FontSize="17" />

                                        <Label
                                            Text="{Binding AlunoMatricula.Cpf, StringFormat='CPF: {0}'}" />

                                        <Label
                                            Text="{Binding Plano, Converter={StaticResource EnumDisplay}}"
                                            FontAttributes="Bold" />

                                        <Label
                                            Text="{Binding DataInicio, StringFormat='Início: {0:dd/MM/yyyy}'}" />

                                        <Label
                                            Text="{Binding DataFim, StringFormat='Término: {0:dd/MM/yyyy}'}" />

                                        <Label
                                            Text="{Binding Objetivo, StringFormat='Objetivo: {0}'}" />

                                        <Label
                                            Text="{Binding RestricoesMedicas, Converter={StaticResource RestricoesDisplay}}"
                                            LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="8">

                                        <Image
                                            Source="{Binding AlunoMatricula.Foto, Converter={StaticResource FotoConverter}}"
                                            WidthRequest="100"
                                            HeightRequest="100"
                                            Aspect="AspectFill" />

                                        <Button
                                            Text="Editar"
                                            Clicked="OnEditButtonClicked"
                                            Style="{StaticResource ButtonPrimary}" />

                                        <Button
                                            Text="Excluir"
                                            Clicked="OnDeleteButtonClicked"
                                            Style="{StaticResource ButtonSecondary}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout
                            Spacing="12"
                            VerticalOptions="Center"
                            HorizontalOptions="Center">
                            <Label Text="Nenhuma matrícula encontrada." />
                            <Button
                                Text="Nova matrícula"
                                Command="{Binding AddMatriculaCommand}"
                                Style="{StaticResource ButtonPrimary}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>

            <Button
                Text="+"
                Command="{Binding AddMatriculaCommand}"
                Style="{StaticResource ButtonPrimary}"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                FontSize="24"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20" />
        </Grid>

        <ActivityIndicator
            Grid.RowSpan="2"
            IsVisible="{Binding IsBusy}"
            IsRunning="{Binding IsBusy}"
            VerticalOptions="Center"
            HorizontalOptions="Center" />
    </Grid>
</ContentPage>